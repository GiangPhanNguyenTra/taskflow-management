{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taskflow-desktop",
  "version": "0.1.0",
  "identifier": "com.taskflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "taskflow-desktop",
        "width": 800,
        "height": 600
      },
      {
        "label": "pinned-reminder",
        "title": "TaskFlow reminder",
        "url": "pinned.html",
        "width": 520,
        "height": 260,
        "minWidth": 210,
        "minHeight": 58,
        "maxWidth": 540,
        "maxHeight": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": { "preload": ["sqlite:taskflow.db"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
